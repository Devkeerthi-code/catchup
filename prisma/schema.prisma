// CatchUp stores accounts, saved summaries, anonymous usage counts and rate-limit windows.
// It never stores chat text: SavedCatchup.summary holds only the generated catch-up.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique @db.VarChar(254)
  passwordHash String         @db.VarChar(100)
  createdAt    DateTime       @default(now())
  catchups     SavedCatchup[]
}

model SavedCatchup {
  id           String   @id @default(cuid())
  /// Generated by the browser for each catch-up, so a double-click or retry can't save it twice.
  clientId     String   @db.Uuid
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String   @db.VarChar(120)
  source       String   @db.VarChar(20)
  rangeStart   DateTime
  rangeEnd     DateTime
  messageCount Int
  itemCount    Int
  summary      Json
  createdAt    DateTime @default(now())

  @@unique([userId, clientId])
  @@index([userId, createdAt(sort: Desc)])
}

// One row per (day, action): counts only, no user ids, no IP addresses.
model UsageCount {
  day    DateTime @db.Date
  action String   @db.VarChar(40)
  count  Int      @default(0)

  @@id([day, action])
}

// Fixed-window counters. `key` is a salted hash of the client IP or a global bucket name.
model RateLimitWindow {
  key         String   @db.VarChar(80)
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}
