# Copy this file to .env and fill in every value. Never commit .env.

# Postgres connection string. Neon free tier works: Dashboard -> Connect -> copy the pooled URL.
# Example shape: postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Google Gemini API key from https://aistudio.google.com/apikey (free tier is enough).
GEMINI_API_KEY=

# Optional. Model used for summaries, and a lighter one tried once if the first is busy or out of quota.
# Defaults: gemini-3.5-flash and gemini-3.1-flash-lite. Must be available on the v1 API for your key.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Signs the login cookie. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Salt for hashing IP addresses in rate limits (raw IPs are never stored). At least 16 random characters.
HASH_SALT=

# Comma-separated emails that may open /admin (anonymous usage counts). Leave empty to disable /admin.
ADMIN_EMAILS=

# Optional rate limits for the free Gemini quota. Defaults shown.
# AI_CALLS_PER_IP_PER_HOUR=60
# GEMINI_CALLS_PER_MINUTE=10
# GEMINI_CALLS_PER_DAY=800
